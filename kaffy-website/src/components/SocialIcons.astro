---
// Icon links for every profile in Site settings → Social links.
import settings from '../data/settings.json';
interface Props { tone?: 'light' | 'dark'; size?: number }
const { tone = 'dark', size = 20 } = Astro.props;
const paths: Record<string, string> = {
  YouTube: 'M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.4-1.6.5-4.8.5-4.8s0-3.2-.5-4.8zM9.7 15V9l5.8 3-5.8 3z',
  TikTok: 'M16.6 2h-3.4v13.3a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9a6.3 6.3 0 1 0 5.4 6.3V8.6a7.6 7.6 0 0 0 4.4 1.4V6.6a4.4 4.4 0 0 1-4.4-4.6z',
  Instagram: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2zm0 1.8A3.7 3.7 0 0 0 3.8 7.5v9a3.7 3.7 0 0 0 3.7 3.7h9a3.7 3.7 0 0 0 3.7-3.7v-9a3.7 3.7 0 0 0-3.7-3.7z',
  Facebook: 'M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z',
  LinkedIn: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z',
};
const links = settings.socials.filter((s) => paths[s.name]);
---
<ul class:list={['social-icons', tone]} aria-label="Follow Kaffy">
  {links.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="me noopener" aria-label={`Kaffy Olaitan on ${s.name}`} title={s.name}>
        <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d={paths[s.name]} /></svg>
      </a>
    </li>
  ))}
</ul>
<style>
  .social-icons { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; align-items: center; }
  .social-icons a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background .2s, border-color .2s; }
  .social-icons svg { fill: var(--black); }
  .social-icons a:hover { background: var(--black); border-color: var(--black); }
  .social-icons a:hover svg { fill: var(--white); }
  .social-icons.light a { border-color: var(--dark-line); }
  .social-icons.light svg { fill: var(--on-dark); }
  .social-icons.light a:hover { background: var(--champagne); border-color: var(--champagne); }
  .social-icons.light a:hover svg { fill: var(--dark); }
</style>
