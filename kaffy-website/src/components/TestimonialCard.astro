---
// Shows the original screenshot. The typed quote is kept as alt text so search engines can read it.
interface Props { t: { quote: string; name: string; source: string; image?: string } }
const { t } = Astro.props;
---
<figure class="tshot">
  {t.image
    ? <img src={t.image} alt={`${t.name} on ${t.source}: "${t.quote}"`} loading="lazy" />
    : <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>}
  <figcaption><strong>{t.name}</strong> &middot; {t.source}</figcaption>
</figure>
<style>
  .tshot { margin: 0; background: var(--white); border: 1px solid var(--line); padding: 10px 10px 14px; break-inside: avoid; }
  .tshot img { width: 100%; display: block; }
  .tshot blockquote { margin: 8px; font: 500 20px/1.4 var(--serif); color: var(--black); }
  .tshot figcaption { font-size: 13px; color: var(--muted); padding: 10px 4px 0; }
  .tshot strong { color: var(--ink); font-weight: 600; }
  .dark .tshot { background: var(--white); }
</style>
