---
import FormFields from './FormFields.astro';
import { formAction } from '../lib/forms';
import settings from '../data/settings.json';
---
<section class="section dark newsletter" id="newsletter" aria-labelledby="nl-title">
  <div class="wrap split">
    <div>
      <span class="eyebrow">{settings.newsletterName}</span>
      <h2 id="nl-title">One email. Every week. The business lessons I had to learn the expensive way.</h2>
      <p class="lead">Business insights, marketing ideas, sales lessons and honest reflections from building in real time. Free, and you can leave whenever you like.</p>
    </div>
    <form class="form" name="newsletter" method="POST" action={formAction}>
        <FormFields subject="New newsletter sign-up" next="https://kaffyolaitan.com/thank-you/?form=newsletter" />
      <div>
        <label for="nl-name">First name</label>
        <input id="nl-name" name="first_name" autocomplete="given-name" />
      </div>
      <div>
        <label for="nl-email">Email address</label>
        <input id="nl-email" name="email" type="email" required autocomplete="email" />
      </div>
      <label class="consent"><input type="checkbox" name="consent" value="yes" required /> <span>Yes, send me {settings.newsletterName}. I can unsubscribe at any time. See the <a href="/privacy/">privacy policy</a>.</span></label>
      <div><button class="btn" type="submit">Join the letter</button></div>
    </form>
  </div>
</section>
