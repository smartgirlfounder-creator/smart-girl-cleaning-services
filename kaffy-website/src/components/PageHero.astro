---
interface Props { eyebrow: string; title: string; lead?: string; image?: string; imageAlt?: string }
const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---
<section class="page-hero">
  <div class:list={['wrap', { split: image, 'wide-left': image }]}>
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <div class="photo hero-photo"><img src={image} alt={imageAlt} width="800" height="1000" fetchpriority="high" /></div>
    )}
  </div>
</section>
<style>
  .page-hero { padding: clamp(56px, 9vw, 112px) 0 clamp(40px, 6vw, 72px); border-bottom: 1px solid var(--line); }
  .hero-photo { aspect-ratio: 4 / 5; max-height: 560px; }
</style>
