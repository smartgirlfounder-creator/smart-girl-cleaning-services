---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import Share from '../../components/Share.astro';
import settings from '../../data/settings.json';
import { published, formatDate, youtubeId, breadcrumbs } from '../../lib/utils';

export async function getStaticPaths() {
  const all = published(await getCollection('podcast'));
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: CollectionEntry<'podcast'>; all: CollectionEntry<'podcast'>[] }
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const site = Astro.site!;
const path = `/podcast/${entry.id}/`;
const vid = youtubeId(d.youtube);
const related = all.filter((e) => e.id !== entry.id && e.data.category === d.category).concat(all.filter((e) => e.id !== entry.id && e.data.category !== d.category)).slice(0, 3);
const articles = (await getCollection('articles')).filter((a) => !a.data.draft && a.data.relatedPodcast === entry.id);
const image = d.image ?? (vid ? `https://i.ytimg.com/vi/${vid}/hqdefault.jpg` : undefined);

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastEpisode',
    name: d.title,
    episodeNumber: d.episode,
    datePublished: d.date.toISOString(),
    description: d.summary,
    url: new URL(path, site).toString(),
    partOfSeries: { '@type': 'PodcastSeries', name: settings.podcastName, url: new URL('/podcast/', site).toString() },
    ...(d.audio ? { associatedMedia: { '@type': 'MediaObject', contentUrl: d.audio } } : {}),
  },
  breadcrumbs(site, [['Home', '/'], ['Podcast', '/podcast/'], [d.title, path]]),
];
if (vid) schema.push({
  '@context': 'https://schema.org', '@type': 'VideoObject', name: d.title, description: d.summary,
  uploadDate: d.date.toISOString(), thumbnailUrl: `https://i.ytimg.com/vi/${vid}/hqdefault.jpg`,
  embedUrl: `https://www.youtube.com/embed/${vid}`, contentUrl: `https://www.youtube.com/watch?v=${vid}`,
});
---
<Base title={`${d.title} | ${settings.podcastName} Ep. ${d.episode}`} description={d.summary} image={image} type="article" schema={schema}>
  <article>
    <header class="ep-head">
      <div class="wrap narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/podcast/">{settings.podcastName}</a></nav>
        <span class="eyebrow">Episode {d.episode} &middot; {d.category} &middot; <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
        <h1>{d.title}</h1>
        <p class="lead">{d.summary}</p>
      </div>
    </header>
    <div class="wrap narrow">
      <YouTube url={d.youtube} title={d.title} />
      {d.audio && <audio class="audio" controls preload="none" src={d.audio}>Your browser does not play audio.</audio>}

      {d.lessons.length > 0 && (
        <section class="lessons">
          <h2>Key lessons</h2>
          <ul class="ticks">{d.lessons.map((l) => <li>{l}</li>)}</ul>
        </section>
      )}

      <div class="prose"><h2>Show notes</h2><Content /></div>

      {d.guest && (
        <section class="card guest">
          <span class="eyebrow">The guest</span>
          <h3>{d.guest}</h3>
          {d.guestBio && <p>{d.guestBio}</p>}
        </section>
      )}

      {d.resources.length > 0 && (
        <section class="resources">
          <h2>Resources mentioned</h2>
          <ul>{d.resources.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.title}</a></li>)}</ul>
        </section>
      )}

      {articles.length > 0 && (
        <section class="resources">
          <h2>Read more on this</h2>
          <ul>{articles.map((a) => <li><a href={`/articles/${a.id}/`}>{a.data.title}</a></li>)}</ul>
        </section>
      )}

      <Share title={d.title} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="section white">
      <div class="wrap">
        <span class="eyebrow">Keep listening</span>
        <h2>Related episodes</h2>
        <div class="grid g3">
          {related.map((e) => (
            <a class="card" href={`/podcast/${e.id}/`}>
              <span class="num">Episode {e.data.episode}</span>
              <h3>{e.data.title}</h3>
              <p>{e.data.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  article { padding-bottom: 96px; }
  .ep-head { padding: clamp(48px, 8vw, 96px) 0 40px; }
  .crumbs { font-size: 14px; margin-bottom: 18px; }
  .audio { width: 100%; margin-top: 20px; }
  .lessons { margin: 48px 0 0; }
  .lessons h2, .resources h2 { font-size: clamp(28px, 3.4vw, 38px); }
  .prose { margin-top: 40px; }
  .guest { margin-top: 40px; }
  .resources { margin-top: 40px; }
</style>
