---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import settings from '../../data/settings.json';
import { published, formatDate, slugify, breadcrumbs } from '../../lib/utils';

export async function getStaticPaths() {
  const all = published(await getCollection('articles'));
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
interface Props { entry: CollectionEntry<'articles'>; all: CollectionEntry<'articles'>[] }
const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const site = Astro.site!;
const path = `/articles/${entry.id}/`;
const toc = headings.filter((h) => h.depth === 2);
const related = all.filter((a) => a.id !== entry.id && a.data.category === d.category)
  .concat(all.filter((a) => a.id !== entry.id && a.data.category !== d.category)).slice(0, 3);
const episode = d.relatedPodcast ? await getEntry('podcast', d.relatedPodcast) : undefined;
const day = d.relatedDocumentary ? await getEntry('documentary', d.relatedDocumentary) : undefined;
const words = (entry.body ?? '').split(/\s+/).length;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
    datePublished: d.date.toISOString(), dateModified: d.date.toISOString(), url: new URL(path, site).toString(),
    mainEntityOfPage: new URL(path, site).toString(), articleSection: d.category, wordCount: words,
    author: { '@id': site.toString().replace(/\/$/, '') + '/#person', '@type': 'Person', name: settings.name },
    ...(d.image ? { image: new URL(d.image, site).toString() } : {}),
  },
  breadcrumbs(site, [['Home', '/'], ['Articles', '/articles/'], [d.title, path]]),
];
---
<Base title={`${d.title} | Kaffy Olaitan`} description={d.description} image={d.image} type="article" schema={schema}>
  <article class="article">
    <header class="a-head">
      <div class="wrap narrow">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/articles/">Articles</a> / <a href={`/articles/category/${slugify(d.category)}/`}>{d.category}</a></nav>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="byline">By {settings.name} &middot; <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> &middot; {Math.max(1, Math.round(words / 220))} min read</p>
      </div>
    </header>
    {d.image && <div class="wrap narrow"><div class="photo cover"><img src={d.image} alt={d.imageAlt ?? ''} /></div></div>}
    <div class="wrap narrow">
      {toc.length >= 4 && (
        <nav class="toc" aria-label="In this article">
          <p class="eyebrow">In this article</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose"><Content /></div>

      {(episode || day) && (
        <aside class="card connect">
          <span class="eyebrow">Watch or listen</span>
          {episode && <p><a href={`/podcast/${episode.id}/`}>Podcast, Episode {episode.data.episode}: {episode.data.title}</a></p>}
          {day && <p><a href={`/becoming-kaffy/${day.id}/`}>{settings.documentaryName}, Day {day.data.day}: {day.data.title}</a></p>}
        </aside>
      )}

      <aside class="card call">
        <span class="eyebrow">Want help applying this?</span>
        <p>Book a free 10-minute diagnostic call. We'll find where your business is stuck and the right next step for you.</p>
        <a class="btn" href={settings.diagnosticUrl} target="_blank" rel="noopener">Book my free call</a>
      </aside>

      <aside class="author">
        <img src="/images/photos/kaffy-olaitan-portrait-yellow-800.webp" alt="Kaffy Olaitan" width="96" height="96" loading="lazy" />
        <div>
          <p class="author-name">{settings.name}</p>
          <p>Business educator, entrepreneur and founder of Smart Girl Cleaning Services. She writes about the thinking behind businesses that grow. <a href="/about/">Read her story</a>.</p>
        </div>
      </aside>
      <Share title={d.title} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="section white">
      <div class="wrap">
        <span class="eyebrow">Keep reading</span>
        <h2>Related articles</h2>
        <div class="grid g3">
          {related.map((a) => (
            <a class="card" href={`/articles/${a.id}/`}>
              <span class="num">{a.data.category}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .article { padding-bottom: 96px; }
  .a-head { padding: clamp(48px, 8vw, 96px) 0 32px; }
  .crumbs { font-size: 14px; margin-bottom: 18px; }
  .byline { font-size: 14px; color: var(--muted); }
  .cover { aspect-ratio: 16 / 9; margin-bottom: 40px; }
  .toc { border: 1px solid var(--line); background: var(--white); padding: 24px 28px; margin-bottom: 40px; }
  .toc ol { margin: 0; padding-left: 20px; }
  .toc li { margin: 6px 0; }
  .connect, .call { margin-top: 48px; }
  .call p { color: var(--ink); }
  .connect p { margin: 6px 0 0; color: var(--ink); }
  .author { display: flex; gap: 20px; align-items: flex-start; margin-top: 56px; padding: 28px 0; border-top: 1px solid var(--line); }
  .author img { width: 96px; height: 96px; object-fit: cover; object-position: top; border-radius: 50%; flex: none; }
  .author-name { font: 600 22px/1 var(--serif); color: var(--black); margin-bottom: 8px; }
  .author p { font-size: 15px; color: var(--muted); }
</style>
