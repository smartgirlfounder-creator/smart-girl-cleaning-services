---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import resources from '../data/resources.json';
import { breadcrumbs, slugify } from '../lib/utils';
import settings from '../data/settings.json';

const featured = resources.items.find((r) => r.featured);
const site = Astro.site!.toString().replace(/\/$/, '');
const books = resources.items.filter((r) => r.category === 'Books and Publications' && r.url).map((b) => ({
  '@context': 'https://schema.org', '@type': 'Book', name: b.title, description: b.description, url: b.url,
  author: { '@id': site + '/#person' },
}));
const shelves = [
  { name: 'Business Education', text: 'Guides to starting, planning and growing a business.' },
  { name: 'Marketing and Sales', text: 'Frameworks for positioning, customer acquisition, selling and consumer psychology.' },
  { name: 'Women and Entrepreneurship', text: 'Practical resources on starting a business and financial independence.' },
  { name: 'Books and Publications', text: 'My first book is for cleaning business owners. A book on business for every entrepreneur is in progress.' },
  { name: 'Tools and Templates', text: 'Calculators, templates and practical business tools.' },
  { name: 'Courses and Masterclasses', text: 'Online programmes, masterclasses and workshops.' },
  { name: 'Community', text: 'Grow with other entrepreneurs who are building too.' },
];
---
<Base
  title="Business Resources, Tools and Guides | Kaffy Olaitan"
  description="Business education resources from Kaffy Olaitan: guides, marketing and sales frameworks, tools and templates for entrepreneurs and small business owners."
  schema={[breadcrumbs(Astro.site!, [['Home', '/'], ['Resources', '/resources/']]), ...books]}
>
  <PageHero eyebrow="Resources" title="Tools for people who build." lead="Practical guides, templates and tools to help you think better about your business. The library grows as new resources are released.">
    <div class="btn-row">
      <a class="btn" href={settings.storeUrl} target="_blank" rel="noopener">Visit my store</a>
      <a class="btn ghost" href="https://linktr.ee/Smartgirlclean" target="_blank" rel="noopener">All my links</a>
    </div>
  </PageHero>
  {featured && (
    <section class="section dark">
      <div class="wrap split">
        <div>
          <span class="eyebrow">{featured.badge || 'Featured'}</span>
          <h2>{featured.title}</h2>
          <p class="lead">{featured.description}</p>
        </div>
        <div><a class="btn" href={featured.url} target="_blank" rel="noopener">{featured.cta}</a></div>
      </div>
    </section>
  )}
  <section class="section white">
    <div class="wrap">
      <p class="store-note">Tools, templates and guides are all available in <a href={settings.storeUrl} target="_blank" rel="noopener">my Selar store</a>. Here are the highlights.</p>
      {shelves.map((s) => {
        const items = resources.items.filter((r) => r.category === s.name);
        return (
          <section class="shelf" id={slugify(s.name)}>
            <div class="shelf-head"><h2>{s.name}</h2><p>{s.text}</p></div>
            {items.length > 0 ? (
              <div class="grid g3">
                {items.map((r) => (
                  <article class="card">
                    {r.badge && <span class="badge">{r.badge}</span>}
                    <h3>{r.title}</h3>
                    <p>{r.description}</p>
                    <a class="link-arrow" href={r.url || '/contact/?type=general'} target={r.url ? '_blank' : undefined} rel={r.url ? 'noopener' : undefined}>{r.cta}</a>
                  </article>
                ))}
              </div>
            ) : (
              <p class="soon">Coming soon. <a href="#newsletter">Join the letter</a> to hear first.</p>
            )}
          </section>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .store-note { color: var(--muted); margin: 0 0 8px; }
  .shelf { padding: 40px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  .shelf-head { margin-bottom: 20px; }
  .shelf-head h2 { font-size: clamp(28px, 3.4vw, 38px); margin-bottom: 6px; }
  .badge { display: inline-block; font: 600 11px/1 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--white); background: var(--taupe); padding: 6px 10px; margin-bottom: 14px; }
  .shelf-head p, .soon { color: var(--muted); margin: 0; }
</style>
